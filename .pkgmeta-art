# BigWigs packager config for the Art addon (the generated map art):
# https://github.com/BigWigsMods/packager/wiki/Preparing-the-PackageMeta-File
#
# Used with `-m .pkgmeta-art` by release-addon-art.yml, publish-art-release-curseforge.yml
# and validate-changes.yml. The client addon is built from the default .pkgmeta.
#
# The zip is dominated by src/addon/art/WorldMap/, which is generated (and
# .gitignored), not committed. CI regenerates it and then `git add -fN`s it so
# the packager stops treating it as an untracked file and copies it into the
# package. See .github/workflows/release-addon-art.yml.

# The folder name is the addon name the client's OptionalDeps and
# Config.FDID_BASE point at, and the name existing hfwm-art installs use.
package-as: HighFidelityWorldMap_MapData_Forever

# No colon in the value: the packager's pkgmeta parser splits on the first one.
changelog-title: High Fidelity World Map - Forever Art

# The packager would write a CHANGELOG.md into the package. A manual changelog
# is read from the checkout instead and only used for the upload, so none ships.
# The workflows write it with .github/scripts/release-notes.sh.
manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

# Hoist the addon out of src/addon/art/ so the TOC ends up at the package root.
move-folders:
  HighFidelityWorldMap_MapData_Forever/src/addon/art: HighFidelityWorldMap_MapData_Forever

# Everything outside src/addon/art/ belongs to the client addon or is build
# machinery. Dotfiles (.github, .git, .gitignore, .pkgmeta, .release,
# src/generator/.cache-*) are skipped by the packager on its own. A new
# top-level file or folder that is not part of the art needs an entry here.
ignore:
  - AI-DISCLOSURE.md
  - CONTRIBUTING.md
  - CurseForgeDescription.md
  - README.md
  - HighFidelityWorldMap.code-workspace
  - assets
  - docs
  - src/addon/client
  - src/generator

# Art only: no libraries, and nothing to split into flavours or nolib builds.
enable-nolib-creation: no
enable-toc-creation: no
